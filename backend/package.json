{
  "name": "dpg_backend",
  "version": "2.0.0",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json,css}\"",
    "test": "bun test",
    "dev": "bun run --watch src/index.server.ts",
    "lint": "oxlint --deny-warnings src/",
    "lint:fix": "oxlint --fix --deny-warnings src/",
    "prod": "bun install && bun admin:build && bun run db:build && bun run server",
    "db:clear": "rm -f data/db.sqlite data/db.sqlite-wal data/db.sqlite-shm",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:restore": "bun run scripts/restore.script.ts",
    "db:studio": "drizzle-kit studio",
    "db:import-pocketbase": "bun run scripts/pocketbase.script.ts",
    "db:build": "bun build --target bun --outfile server src/index.server.ts",
    "server": "bun ./server",
    "backup": "bun run scripts/backup.script.ts",
    "compress-images": "bun run scripts/compress.server.ts",
    "admin:install": "cd admin && bun install",
    "admin:build": "cd admin && bun install && bun run build"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/jwt": "^1.4.2",
    "drizzle-orm": "^0.45.2",
    "elysia": "1.4.29"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "drizzle-kit": "^0.31.10",
    "oxlint": "^1.70.0",
    "prettier": "^3.8.4",
    "typescript": "^6.0.3"
  },
  "module": "src/index.server.ts"
}
